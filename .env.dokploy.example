# Cole no Environment do app FRONTEND no Dokploy (painel rdofertas).
# Não use DATABASE_URL, MYSQL_*, REDIS_* — isso é só no repo backend.

# URL pública da API — o browser chama direto (evita 502 do nginx /api).
API_PUBLIC_URL=https://backlmbot.simplapp.com.br

# Build do Docker (ARG) — login ML noVNC; mesmo host do domínio VNC (porta 6080 na API)
VITE_NOVNC_PUBLIC_URL=https://vnc-backlmbot.simplapp.com.br

# Opcional: proxy same-origin (só se API_PUBLIC_URL estiver vazio)
# API_PROXY_UPSTREAM=https://backlmbot.simplapp.com.br
