# Cole no Environment do app FRONTEND no Dokploy (painel rdofertas).
# Não use DATABASE_URL, MYSQL_*, REDIS_* — isso é só no repo backend.

# API pública do backend (mesmo path /api/v1). Inclua https://
API_PROXY_UPSTREAM=https://backlmbot.simplapp.com.br

# Alternativa na mesma rede Docker (sem https://):
# API_PROXY_UPSTREAM=nome-interno-do-backend:3001
