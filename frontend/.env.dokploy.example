# Cole no Environment do app FRONTEND no Dokploy (painel rdofertas).
# Não use DATABASE_URL, MYSQL_*, REDIS_* — isso é só no repo backend.

# Host interno do serviço da API na mesma rede Docker (exemplo — ajuste no painel):
API_PROXY_UPSTREAM=bot-ml-radar-api:3001

# Build Arguments no Dokploy (opcional — só se a API for outro domínio HTTPS):
# VITE_API_BASE_URL=https://api.simplapp.com.br
