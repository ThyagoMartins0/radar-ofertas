# cp docker-compose.backend-network.yml.example docker-compose.override.yml
#
# API_PROXY_UPSTREAM = nome do serviço/container da API na rede compartilhada.

services:
  frontend:
    environment:
      API_PROXY_UPSTREAM: ${API_PROXY_UPSTREAM:-api:3001}
    networks:
      - backend

  frontend-dev:
    environment:
      VITE_DEV_API_PROXY_TARGET: http://${API_PROXY_UPSTREAM:-api:3001}
    networks:
      - backend

networks:
  backend:
    external: true
    name: ${BACKEND_NETWORK:-radar-ofertas-backend_default}
