# =============================================================================
# Radar Ofertas — FRONTEND (.env)
# Repositório do painel React. Backend/API: repositório radar-ofertas-backend.
# =============================================================================

# URL base da API (sem barra final).
# Vazio em dev local: o Vite faz proxy de /api → VITE_DEV_API_PROXY_TARGET.
# Produção com API em outro domínio: https://api.seudominio.com
VITE_API_BASE_URL=

# Dev — host da API (backend em npm run api ou Docker na porta 3001)
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:3001

# Servidor Vite
VITE_DEV_HOST=127.0.0.1
VITE_DEV_PORT=5173

# Docker dev (docker compose --profile dev): container → API no host
# VITE_DEV_API_PROXY_TARGET=http://host.docker.internal:3001
# VITE_USE_POLLING=true

# Docker prod (nginx): upstream da API no host (backend exposto em API_PORT)
# API_PROXY_UPSTREAM=host.docker.internal:3001
# FRONTEND_PORT=3000
