# =============================================================================
# Radar Ofertas — FRONTEND (sem DATABASE_URL — banco só no backend)
# =============================================================================

# --- Build / produção ---
# Vazio = browser chama /api no mesmo host (nginx faz proxy).
# Preencha se a API estiver em outro domínio (sem proxy nginx):
# VITE_API_BASE_URL=https://api.seudominio.com

VITE_API_BASE_URL=

# Nginx (docker compose up): host:porta da API
API_PROXY_UPSTREAM=host.docker.internal:3001
FRONTEND_PORT=3000

# --- Dev local (npm run dev) ---
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:3001
VITE_DEV_HOST=127.0.0.1
VITE_DEV_PORT=5173

# --- Dev Docker (docker compose --profile dev) ---
# VITE_DEV_API_PROXY_TARGET=http://host.docker.internal:3001
# VITE_USE_POLLING=true
# VITE_HMR_CLIENT_PORT=5173

# Rede compartilhada com backend (só com docker-compose.override.yml)
# BACKEND_NETWORK=radar-ofertas-backend_default
