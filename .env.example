# =============================================================================
# FRONTEND — sem DATABASE_URL / MYSQL_* (banco só no radar-ofertas-backend)
# =============================================================================
# Copie: cp .env.example .env
# Dokploy: use .env.dokploy.example (variáveis no painel do app)
# =============================================================================

# --- Produção (nginx / Dokploy) ---
# URL pública da API (runtime, vira /config.js). Vazio = same-origin /api.
API_PUBLIC_URL=
VITE_API_BASE_URL=
# Opcional: URL do noVNC (login ML). Normalmente vem da API (`novncUrl`); use se o painel estiver desatualizado.
# VITE_NOVNC_PUBLIC_URL=https://vnc-backlmbot.simplapp.com.br

# Runtime nginx — só se API_PUBLIC_URL estiver vazio.
API_PROXY_UPSTREAM=host.docker.internal:3001

# Só docker compose local (mapeia host:3000 → container:80). Dokploy: Container Port = 80.
FRONTEND_PORT=3000

# --- Dev local (npm run dev) ---
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:3001
VITE_DEV_HOST=127.0.0.1
VITE_DEV_PORT=5173

# --- Dev Docker (docker compose --profile dev) ---
# VITE_DEV_API_PROXY_TARGET=http://host.docker.internal:3001
# VITE_USE_POLLING=true
# VITE_HMR_CLIENT_PORT=5173

# Rede compartilhada com backend: docker-compose.backend-network.yml.example → override
